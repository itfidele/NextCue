{
  "name": "nextcue",
  "version": "0.1.0",
  "description": "A desktop conversation assistant with local AI and optional ChatGPT or Claude accounts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "package": "tauri build",
    "package:mac": "tauri build --bundles app",
    "package:windows": "tauri build --bundles nsis",
    "package:linux": "tauri build --bundles appimage,deb",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "react-markdown": "latest",
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "@tauri-apps/cli": "^2",
    "@playwright/test": "latest"
  }
}
